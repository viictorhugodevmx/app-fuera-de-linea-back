    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:check": "tsx src/db/check.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "tsx src/db/migrate.ts --test",
    "test:unit": "vitest run tests/unit tests/health.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:http": "vitest run tests/http tests/health.test.ts"
  },
